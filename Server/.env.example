# Maximum age of the token in seconds (3 days)
MAX_AGE = 259200 
PORT = 5000 
JWT_KEY = <GENERATE_A_UNIQUE_RANDOM_SECRET>
# Standalone MongoDB is supported using conditional stock updates and compensation.
DB_URL = 'mongodb://localhost:27017/pizza-del-Sys'


