NODE_ENV = 'development' 
# 'production'

EMAIL_HOST = <MAILTRAP_HOST>
EMAIL_USER = <MAILTRAP_USERNAME>
EMAIL_PASSWORD = <MAILTRAP_PASSWORD>
EMAIL_PORT = <MAILTRAP_PORT>


# Email address used for sending emails just like and email address of the system or support.
SYSTEM_EMAIL='support@pizzeria.com'

